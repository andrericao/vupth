# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

#IOS 
ios/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# test coverage
coverage/
# Maestro: o autofill guardado pelo setup.sh (o restaurar.sh devolve e apaga)
.maestro/.autofill_antes
# Maestro: logs e prints de cada rodada (bateria.sh — somem quando o erro e sanado)
.maestro/logs/
# As etapas aprovadas por commit (bateria-pula-aprovados)
.maestro/aprovados.txt
.maestro/aprovados.txt.tmp
# Falhas dos testes do pre-push (DEC-22 — o hook do vupth-docs le daqui)
.logs-teste/
