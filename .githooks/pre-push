#!/bin/sh
#
# Anti-quebra: bloqueia o push se lint, typecheck ou testes falharem.
# Versionado em .githooks/ e ativado via `git config core.hooksPath .githooks`
# (feito automaticamente pelo script "prepare" do package.json no npm install).
#
# Para pular em emergencia: git push --no-verify  (NAO recomendado)

set -e

# Node >= 20.19.4 antes de tudo (o do sistema pode ser o 18) — o mesmo do
# Partner (bateria-alinhada, C28).
. "$(dirname "$0")/node-certo.sh"

echo "🔎 [1/4] Lint..."
npm run --silent lint

echo "🧠 [2/4] Typecheck..."
npm run --silent typecheck

echo "🧪 [3/4] Testes + cobertura (o mesmo gate do CI)..."
# DEC-22/DEC-28: a falha do jest fica em logs/testes/<data>_jest_FALHA.txt, no
# repositorio (o hook do vupth-docs acorda a equipe com ela); verde apaga as
# falhas antigas do jest.
LOGS=logs/testes
mkdir -p "$LOGS"
SAIDA=$(mktemp)
CODIGO=$(mktemp)
{ npm test -- --ci --coverage 2>&1; echo $? > "$CODIGO"; } | tee "$SAIDA"
RC=$(cat "$CODIGO")
rm -f "$CODIGO"
if [ "$RC" != "0" ]; then
  LOG="$LOGS/$(date +%Y-%m-%d_%H%M%S)_jest_FALHA.txt"
  mv "$SAIDA" "$LOG"
  echo "❌ Testes falharam — log em $LOG"
  exit "$RC"
fi
rm -f "$SAIDA" "$LOGS"/*_jest_FALHA.txt

echo "🩺 [4/4] Config (expo-doctor)..."
# Atras de proxy (o cloud), o fetch do Node so o usa com NODE_USE_ENV_PROXY.
[ -n "${HTTPS_PROXY:-}" ] && export NODE_USE_ENV_PROXY=1
npx expo-doctor

echo "✅ Lint + Typecheck + Testes + expo-doctor OK. Push liberado."
