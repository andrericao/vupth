{
  "name": "vupth",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) expo export --platform web",
    "test": "jest",
    "test:integration": "jest src/__tests__/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:catraca": "node tools/catraca-cobertura.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "jest": {
    "preset": "jest-expo",
    "coverageReporters": [
      "json",
      "json-summary",
      "lcov",
      "text",
      "clover"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@gluestack-ui/.*|@gluestack-style/.*|@legendapp/.*|lucide-react-native)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/src/__tests__/__mocks__/",
      "<rootDir>/src/__tests__/mocks/",
      "<rootDir>/src/__tests__/utils/",
      "<rootDir>/src/__tests__/integration/setup.ts"
    ],
    "moduleNameMapper": {
      "^@assets/(.*)$": "<rootDir>/src/assets/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@routes/(.*)$": "<rootDir>/src/routes/$1",
      "^@screens/(.*)$": "<rootDir>/src/screens/$1",
      "^@storage/(.*)$": "<rootDir>/src/storage/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@stores/(.*)$": "<rootDir>/src/stores/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "\\.svg$": "<rootDir>/src/__tests__/__mocks__/svgMock.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock.js"
    },
    "coverageThreshold": {
      "global": {
        "lines": 82,
        "branches": 74,
        "functions": 77,
        "statements": 81
      }
    }
  },
  "dependencies": {
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/themed": "^1.1.73",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "axios": "^1.17.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~54.0.35",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "lucide-react-native": "^1.49.0",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.2",
    "jest-expo": "^55.0.17",
    "msw": "^3.0.1",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
