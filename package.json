{
  "name": "vupth",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:integration": "jest src/__tests__/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@gluestack-ui/.*|@gluestack-style/.*|@legendapp/.*|phosphor-react-native)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/src/__tests__/__mocks__/",
      "<rootDir>/src/__tests__/mocks/",
      "<rootDir>/src/__tests__/integration/setup.ts"
    ],
    "moduleNameMapper": {
      "^@assets/(.*)$": "<rootDir>/src/assets/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@routes/(.*)$": "<rootDir>/src/routes/$1",
      "^@screens/(.*)$": "<rootDir>/src/screens/$1",
      "^@storage/(.*)$": "<rootDir>/src/storage/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@stores/(.*)$": "<rootDir>/src/stores/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "\\.svg$": "<rootDir>/src/__tests__/__mocks__/svgMock.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.2.3",
    "@expo/ngrok": "^4.1.3",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.19",
    "@gluestack-ui/themed": "^1.1.34",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.13.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.35",
    "expo-font": "~14.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "fix": "^0.0.6",
    "jest-expo": "~54.0.17",
    "phosphor-react-native": "^2.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.10",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.17",
    "msw": "^2.14.5",
    "react-native-svg-transformer": "^1.5.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
