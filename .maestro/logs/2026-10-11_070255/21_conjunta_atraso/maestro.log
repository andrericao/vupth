07:13:12.917 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: 21.PD · entra na fila pela API metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runScriptCommand=RunScriptCommand(script=// O cliente entra ou sai da fila pela API (push-na-bateria): com o app
// FECHADO, o push so pode vir de algo feito fora dele.
//
// Entradas (env do runScript): API, SENHA, EMAIL_CLIENTE, ACAO ("entrar"|"sair")
//   entrar: PROF_ID, LOJA_ID, SERVICO_ID — saida: output.ATENDIMENTO_ID
//   sair:   ATENDIMENTO_ID (dentro da tolerancia, sem multa)
//   sair-da-ativa: cancela a entrada em aberto do cliente (feita pelo app)

// PATCH/PUT sem corpo: o http do Maestro (OkHttp) recusa ("method PATCH must
// have a request body", bateria 09/10 20:30, 10.07) — vai um "{}".
function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  // 429 do staging (limite de logins, baterias seguidas — Partner, 11/10): espera
  // o tempo que ele pede ("try again in N s") e tenta de novo, ate 3 vezes.
  var r = null;
  for (var vez = 0; vez < 4; vez++) {
    r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : (metodo === "GET" ? undefined : "{}") });
    if (r.status !== 429 || vez === 3) break;
    var n = /in (\d+) s/.exec(r.body || "");
    var ate = Date.now() + ((n ? parseInt(n[1], 10) : 30) + 2) * 1000;
    while (Date.now() < ate) {}
  }
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var token = pedir("POST", "/auth/login", { email: EMAIL_CLIENTE, password: SENHA }).tokens.access_token;
if (ACAO === "entrar") {
  var at = pedir("POST", "/attendances", {
    professionalId: PROF_ID,
    establishmentId: LOJA_ID,
    serviceItemIds: [SERVICO_ID]
  }, token);
  output.ATENDIMENTO_ID = at.id;
} else if (ACAO === "sair") {
  pedir("PUT", "/attendances/" + ATENDIMENTO_ID + "/cancel", null, token);
} else if (ACAO === "sair-da-ativa") {
  // A entrada veio pelo app (a 13 passa pela tela 10): sem o id na mao, cancela
  // o que ainda nao terminou.
  var meus = pedir("GET", "/attendances/client/me", null, token) || [];
  var fim = ["FINISHED", "CANCELLED", "REMOVED", "IN_PROGRESS", "NO_SHOW"];
  for (var i = 0; i < meus.length; i++) {
    if (fim.indexOf(meus[i].status) < 0) pedir("PUT", "/attendances/" + meus[i].id + "/cancel", null, token);
  }
} else {
  throw new Error("ACAO deve ser entrar, sair ou sair-da-ativa, veio: " + ACAO);
}
, env={ACAO=entrar, EMAIL_CLIENTE=client_c71297521@teste.com, PROF_ID=b217b61a-ce85-4b14-9c8d-46b6493dee9a, LOJA_ID=b07f419e-1ba9-433b-9ec6-ff8ac718bed4, SERVICO_ID=6c5d55a0-db34-4f0c-a678-50a5ed9eaa5c}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/fila_pela_api.js, condition=null, label=21.PD · entra na fila pela API, optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
