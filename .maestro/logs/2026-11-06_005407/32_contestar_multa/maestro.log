  method: "POST",
  headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
});
if (r.status === 201) {
  output.MULTA_ID = json(r.body).penalty_id;
  output.MULTA_OK = "1";
} else if (r.status !== 404) {
  throw new Error("POST /test/penalties -> " + r.status + " " + r.body);
}
