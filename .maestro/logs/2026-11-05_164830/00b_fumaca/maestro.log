//
// Entrada (env da bateria): COMMIT

// COMMIT pode ser uma lista "a|b" (o esperado e os chore(logs) filhos dele): vale qualquer um.
var esperado = (typeof COMMIT === "undefined" || COMMIT == null ? "" : String(COMMIT)).trim().toLowerCase();
