21:00:29.540 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: Run flow when ${typeof SUPERVISAO === 'undefined' || SUPERVISAO != '2'} is true metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// O profissional responde o pedido de corte pela API (o modal do Partner):
// pega o pedido PENDING mais novo e aceita (ACAO=accept) ou recusa (refuse).
//
// Entradas (env do runScript): API, SENHA, EMAIL_PROF, ACAO

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
var pendentes = pedir("GET", "/attendances/cut-requests", null, token);
if (!pendentes || pendentes.length === 0) throw new Error("nenhum pedido de corte pendente para o profissional");
pendentes.sort(function (a, b) { return a.created_at < b.created_at ? 1 : -1; });
pedir("PATCH", "/attendances/cut-requests/" + pendentes[0].id + "/" + ACAO, null, token);
output.PEDIDO_ID = pendentes[0].id;
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${EMAIL_PROF}, ACAO=accept}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/responder_pedido.js, condition=null, label=10.07 · o profissional aceita (API), optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=true, label=null), sourceDescription=null, config=null, label=null, optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
