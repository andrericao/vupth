null, idRegex=push-skip, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), sourceDescription=null, config=null, label=null, optional=false))], condition=null, sourceDescription=fechar_aviso.yaml, config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=null, optional=false)), MaestroCommand(copyTextFromCommand=CopyTextFromCommand(selector=ElementSelector(textRegex=.* · [0-9a-f]{8}, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), label=null, optional=false)), MaestroCommand(runScriptCommand=RunScriptCommand(script=// Para a bateria se o app no aparelho nao roda o commit esperado (Andre, 03/10).
// O texto vem do copyTextFrom da versao do Perfil ("Versão 1.0.3 · 03/10/2026 · c65338e7").
//
// Entrada (env da bateria): COMMIT

var esperado = (typeof COMMIT === "undefined" || COMMIT == null ? "" : String(COMMIT)).trim().toLowerCase().slice(0, 8);
var instalado = String(maestro.copiedText || "");

// Sem COMMIT (rodada fora da bateria.sh, 03/10): nao trava a bateria — avisa
// que a versao nao foi conferida e segue.
if (!esperado) {
  console.log(
    "AVISO: versao NAO conferida (sem COMMIT). Instalado: \"" + instalado +
      "\". Para conferir, rode pela bateria.sh: bash .maestro/bateria.sh"
  );
} else if (instalado.toLowerCase().indexOf(esperado) < 0) {
  throw new Error(
    "Versao errada no aparelho. Instalado: \"" + instalado + "\". Esperado: o commit " + esperado +
      ". Instale o APK certo ou espere o OTA da dev e rode de novo."
