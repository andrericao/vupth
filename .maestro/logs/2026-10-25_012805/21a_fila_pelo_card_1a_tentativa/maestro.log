09:17:47.711 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: 21.P0 · prepara a etapa metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(defineVariablesCommand=DefineVariablesCommand(env={ETAPA=21, TAG=${(typeof TAG !== 'undefined' && TAG ? String(TAG) : String(Date.now()).slice(-6)) + '1'}, LOJA=1, CONTA=1, ABERTURA=1, FILA_FECHADA=0}, label=null, optional=false)), MaestroCommand(applyConfigurationCommand=ApplyConfigurationCommand(config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=null, optional=false)), MaestroCommand(evalScriptCommand=EvalScriptCommand(scriptString=${output.TAG = (typeof TAG !== 'undefined' && TAG ? String(TAG) : String(Date.now()).slice(-6)) + ETAPA}, label=${ETAPA}.P1 · calcula TAG, optional=false)), MaestroCommand(evalScriptCommand=EvalScriptCommand(scriptString=${output.EMAIL_CLIENTE = 'client_c' + output.TAG + '@teste.com'; output.NOME_CLIENTE = 'Cliente' + output.TAG}, label=${ETAPA}.P2 · calcula o cliente, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Monta, pela API do staging, uma loja ABERTA com um profissional TRABALHANDO
// e um servico — o papel do app do Partner, para a bateria do client nao
// depender dele. Solo shop: o dono e o proprio profissional.
//
// Entradas (env do runScript): API, SENHA, TAG
// Saidas: output.LOJA, output.LOJA_ID, output.PROF, output.PROF_ID,
//         output.SERVICO_ID, output.EMAIL_PROF

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  // 429 do staging (limite de logins, baterias seguidas — Partner, 11/10): espera
  // o tempo que ele pede ("try again in N s") e tenta de novo, ate 3 vezes.
  var r = null;
  for (var vez = 0; vez < 4; vez++) {
    r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
    if (r.status !== 429 || vez === 3) break;
    var n = /in (\d+) s/.exec(r.body || "");
    var ate = Date.now() + ((n ? parseInt(n[1], 10) : 30) + 2) * 1000;
    while (Date.now() < ate) {}
  }
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

// Cada papel novo (OWNER, PROFESSIONAL) so vale no token depois do refresh.
function renovar(refresh) {
  return pedir("POST", "/auth/refresh", { refresh_token: refresh });
}

var loja = "Loja C" + TAG;
var prof = "Prof" + TAG;
var email = "prop_c" + TAG + "@teste.com";

pedir("POST", "/auth/register", { email: email, password: SENHA });
var sessao = pedir("POST", "/auth/login", { email: email, password: SENHA }).tokens;

var est = pedir("POST", "/establishment/quick-create", { name: loja, serviceType: "BARBER" }, sessao.access_token);
sessao = renovar(sessao.refresh_token);

// Sem horario a loja nao abre (422 ESTABLISHMENT_HOURS_REQUIRED). O dia todo,
// para a bateria rodar a qualquer hora (perto da meia-noite, o bateria.sh espera).
pedir("PATCH", "/establishment/" + est.id + "/general-infos", { opening_time: "00:00", closing_time: "23:59" }, sessao.access_token);

var p = pedir("POST", "/professional/quick-create", { name: prof, establishmentId: est.id, specialty: "Corte" }, sessao.access_token);
sessao = renovar(sessao.refresh_token);

var servico = pedir("POST", "/establishment/" + est.id + "/service-items", {
  establishmentId: est.id,
  serviceItemType: "CORTE_MAQUINA",
  customName: "Corte " + TAG,
  // preco-sobre-o-total (DEC-54): R$ 40 para o profissional, sem absorcao —
  // o cliente paga 42,90 (o menor X,90 em que preco - 4% - 2% >= 40). O preco
  // antigo leva 422 do Backend novo. Os mesmos campos do preparo.js do Partner.
  price: 42.9,
  pro_receives: 40,
  base_price: 40,
  estimatedMinutes: 30
}, sessao.access_token);

// Trabalhando: a loja abre sozinha (open_status derivado, S1 fatia 2).
pedir("PATCH", "/professional/me/status", { status: "WORKING" }, sessao.access_token);

output.LOJA = loja;
output.LOJA_ID = est.id;
output.PROF = prof;
output.PROF_ID = p.id;
output.SERVICO_ID = servico.id;
output.EMAIL_PROF = email;
, env={API=${API}, SENHA=${SENHA}, TAG=${output.TAG}}, sourceDescription=/home/andre/Documentos/programacao/vupth-project/vupth/.maestro/scripts/loja_aberta.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${LOJA == '1'}, label=null), sourceDescription=null, config=null, label=${ETAPA}.P3 · monta a loja pela API, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Fecha a fila do profissional de teste pela API (o "fechar fila" do Partner):
// ele continua trabalhando, mas nao aceita cliente novo.
//
// Fila VAZIA fechada vira OFF (regra do Andre de 22/07, Backend 4f817a0): o
// profissional sai do expediente e a loja fecha. Com alguem na fila ele segue
// WORKING ("Fila fechada") ate o ultimo atendimento. Por isso, antes de fechar,
// um segundo cliente (fila_c<TAG>, so pela API) entra na fila dele.
//
// Entradas (env do runScript): API, SENHA, EMAIL_PROF, TAG, PROF_ID, LOJA_ID, SERVICO_ID

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  // 429 do staging (limite de logins, baterias seguidas — Partner, 11/10): espera
  // o tempo que ele pede ("try again in N s") e tenta de novo, ate 3 vezes.
  var r = null;
  for (var vez = 0; vez < 4; vez++) {
    r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
    if (r.status !== 429 || vez === 3) break;
    var n = /in (\d+) s/.exec(r.body || "");
    var ate = Date.now() + ((n ? parseInt(n[1], 10) : 30) + 2) * 1000;
    while (Date.now() < ate) {}
  }
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var emailFila = "fila_c" + TAG + "@teste.com";
pedir("POST", "/auth/register", { email: emailFila, password: SENHA });
var tokenFila = pedir("POST", "/auth/login", { email: emailFila, password: SENHA }).tokens.access_token;
pedir("PATCH", "/profile/general-infos", { first_name: "Na fila" }, tokenFila);
pedir("POST", "/attendances", { professionalId: PROF_ID, establishmentId: LOJA_ID, serviceItemIds: [SERVICO_ID] }, tokenFila);

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
pedir("PATCH", "/professional/me/accepting-new", { value: false }, token);
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${output.EMAIL_PROF}, TAG=${output.TAG}, PROF_ID=${output.PROF_ID}, LOJA_ID=${output.LOJA_ID}, SERVICO_ID=${output.SERVICO_ID}}, sourceDescription=/home/andre/Documentos/programacao/vupth-project/vupth/.maestro/scripts/fechar_fila.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${FILA_FECHADA == '1'}, label=null), sourceDescription=null, config=null, label=${ETAPA}.P4 · fecha a fila pela API (um cliente entra antes), optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Poe o profissional de teste em "Fora" pela API (as pills de status do
// Partner): a loja fecha, e o cliente so pode pedir o corte (DEC-27).
//
// Entradas (env do runScript): API, SENHA, EMAIL_PROF

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  // 429 do staging (limite de logins, baterias seguidas — Partner, 11/10): espera
  // o tempo que ele pede ("try again in N s") e tenta de novo, ate 3 vezes.
