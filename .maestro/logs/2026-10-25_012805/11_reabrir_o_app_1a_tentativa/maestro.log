// O texto vem do copyTextFrom da versao do Perfil ("Versão 1.0.3 · 03/10/2026 · c65338e7").
//
// Entrada (env da bateria): COMMIT

var esperado = (typeof COMMIT === "undefined" || COMMIT == null ? "" : String(COMMIT)).trim().toLowerCase().slice(0, 8);
var instalado = String(maestro.copiedText || "");

// Sem COMMIT (rodada fora da bateria.sh, 03/10): nao trava a bateria — avisa
// que a versao nao foi conferida e segue.
if (!esperado) {
  console.log(
    "AVISO: versao NAO conferida (sem COMMIT). Instalado: \"" + instalado +
      "\". Para conferir, rode pela bateria.sh: bash .maestro/bateria.sh"
  );
} else if (instalado.toLowerCase().indexOf(esperado) < 0) {
  throw new Error(
    "Versao errada no aparelho. Instalado: \"" + instalado + "\". Esperado: o commit " + esperado +
      ". Instale o APK certo ou espere o OTA da dev e rode de novo."
  );
}
, env={}, sourceDescription=/home/andre/Documentos/programacao/vupth-project/vupth/.maestro/scripts/confere_versao.js, condition=null, label=null, optional=false))], condition=null, sourceDescription=atualizar.yaml, config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=true, label=null), sourceDescription=null, config=null, label=11.PB · atualiza o app e confere a versão, optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
