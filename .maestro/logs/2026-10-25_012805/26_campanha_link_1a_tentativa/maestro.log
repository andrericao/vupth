var emailFila = "fila_c" + TAG + "@teste.com";
pedir("POST", "/auth/register", { email: emailFila, password: SENHA });
var tokenFila = pedir("POST", "/auth/login", { email: emailFila, password: SENHA }).tokens.access_token;
