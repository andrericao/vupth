16:41:31.790 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: Run /home/andre/Documentos/programacao/vupth-project/vupth/.maestro/scripts/cliente.js metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runScriptCommand=RunScriptCommand(script=// Cria, pela API do staging, a conta do cliente de uma etapa avulsa
// (bateria-nao-para): cada etapa roda sozinha e nao herda o cadastro da 02.
// Ja com o nome, para o login nao parar na tela "Como podemos te chamar?".
//
// Entradas (env do runScript): API, SENHA, EMAIL_CLIENTE, NOME_CLIENTE

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  // 429 do staging (limite de logins, baterias seguidas — Partner, 11/10): espera
  // o tempo que ele pede ("try again in N s") e tenta de novo, ate 3 vezes.
  var r = null;
  for (var vez = 0; vez < 4; vez++) {
    r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
    if (r.status !== 429 || vez === 3) break;
    var n = /in (\d+) s/.exec(r.body || "");
    var ate = Date.now() + ((n ? parseInt(n[1], 10) : 30) + 2) * 1000;
    while (Date.now() < ate) {}
  }
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

pedir("POST", "/auth/register", { email: EMAIL_CLIENTE, password: SENHA });
var token = pedir("POST", "/auth/login", { email: EMAIL_CLIENTE, password: SENHA }).tokens.access_token;
pedir("PATCH", "/profile/general-infos", { first_name: NOME_CLIENTE }, token);
