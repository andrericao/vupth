pedir("PATCH", "/professional/me/accepting-new", { value: false }, token);
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${output.EMAIL_PROF}, TAG=${output.TAG}, PROF_ID=${output.PROF_ID}, LOJA_ID=${output.LOJA_ID}, SERVICO_ID=${output.SERVICO_ID}}, sourceDescription=/home/andre/Documentos/programacao/vupth-project/vupth/.maestro/scripts/fechar_fila.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=false, label=null), sourceDescription=null, config=null, label=00.P4 · fecha a fila pela API (um cliente entra antes), optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
