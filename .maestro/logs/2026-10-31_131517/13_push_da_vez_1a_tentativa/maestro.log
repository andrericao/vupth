  console.log(
    "AVISO: versao NAO conferida (sem COMMIT). Instalado: \"" + instalado +
      "\". Para conferir, rode pela bateria.sh: bash .maestro/bateria.sh"
  );
} else if (instalado.toLowerCase().indexOf(esperado) < 0) {
