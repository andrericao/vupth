16:48:36.833 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: 13.02 · entra na fila pela API metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runScriptCommand=RunScriptCommand(script=// O cliente entra ou sai da fila pela API (push-na-bateria): com o app
// FECHADO, o push so pode vir de algo feito fora dele.
//
// Entradas (env do runScript): API, SENHA, EMAIL_CLIENTE, ACAO ("entrar"|"sair")
//   entrar: PROF_ID, LOJA_ID, SERVICO_ID — saida: output.ATENDIMENTO_ID
//   sair:   ATENDIMENTO_ID (dentro da tolerancia, sem multa)

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var token = pedir("POST", "/auth/login", { email: EMAIL_CLIENTE, password: SENHA }).tokens.access_token;
if (ACAO === "entrar") {
  var at = pedir("POST", "/attendances", {
    professionalId: PROF_ID,
    establishmentId: LOJA_ID,
    serviceItemIds: [SERVICO_ID]
  }, token);
  output.ATENDIMENTO_ID = at.id;
} else if (ACAO === "sair") {
  pedir("PUT", "/attendances/" + ATENDIMENTO_ID + "/cancel", null, token);
} else {
  throw new Error("ACAO deve ser entrar ou sair, veio: " + ACAO);
}
, env={ACAO=entrar, EMAIL_CLIENTE=client_c57122113@teste.com, PROF_ID=e77a12bc-662c-47d3-99f1-0620222bbbd1, LOJA_ID=be5594d9-b6fa-4c86-a7fb-8988428dbad6, SERVICO_ID=49f777df-0be1-4c67-a651-0f7e4ed41f1f}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/fila_pela_api.js, condition=null, label=13.02 · entra na fila pela API, optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
