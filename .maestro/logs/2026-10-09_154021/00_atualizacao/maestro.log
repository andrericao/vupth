15:40:48.085 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: ${ETAPA}.P4 · fecha a fila pela API metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Fecha a fila do profissional de teste pela API (o "fechar fila" do Partner):
// ele continua trabalhando, mas nao aceita cliente novo.
//
// Entradas (env do runScript): API, SENHA, EMAIL_PROF

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
pedir("PATCH", "/professional/me/accepting-new", { value: false }, token);
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${output.EMAIL_PROF}}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/fechar_fila.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=false, label=null), sourceDescription=null, config=null, label=00.P4 · fecha a fila pela API, optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
