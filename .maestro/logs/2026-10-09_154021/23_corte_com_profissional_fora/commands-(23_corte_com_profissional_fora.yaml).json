  "command" : {
    "runFlowCommand" : {
      "commands" : [ {
        "runScriptCommand" : {
          "script" : "// Poe o profissional de teste em \"Fora\" pela API (as pills de status do\n// Partner): a loja fecha, e o cliente so pode pedir o corte (DEC-27).\n//\n// Entradas (env do runScript): API, SENHA, EMAIL_PROF\n\nfunction pedir(metodo, url, corpo, token) {\n  var headers = { \"Content-Type\": \"application/json\" };\n  if (token) headers[\"Authorization\"] = \"Bearer \" + token;\n  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });\n  if (r.status >= 300) throw new Error(metodo + \" \" + url + \" -> \" + r.status + \" \" + r.body);\n  return r.body ? json(r.body) : null;\n}\n\nvar token = pedir(\"POST\", \"/auth/login\", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;\npedir(\"PATCH\", \"/professional/me/status\", { status: \"OFF\" }, token);\n",
          "env" : {
            "API" : "${API}",
            "SENHA" : "${SENHA}",
            "EMAIL_PROF" : "${output.EMAIL_PROF}"
          },
          "sourceDescription" : "/home/andre/Documentos/programacao/vupth/.maestro/scripts/profissional_fora.js",
          "optional" : false
        }
      } ],
      "condition" : {
        "scriptCondition" : "${typeof PROF_FORA !== 'undefined' && PROF_FORA == '1'}"
      },
      "label" : "${ETAPA}.P4b · põe o profissional em Fora pela API",
      "optional" : false
    }
  },
  "metadata" : {
    "status" : "COMPLETED",
