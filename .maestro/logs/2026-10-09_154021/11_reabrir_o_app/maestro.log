(o modal do Partner):
// pega o pedido PENDING mais novo e aceita (ACAO=accept) ou recusa (refuse).
//
// Entradas (env do runScript): API, SENHA, EMAIL_PROF, ACAO

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
var pendentes = pedir("GET", "/attendances/cut-requests", null, token);
if (!pendentes || pendentes.length === 0) throw new Error("nenhum pedido de corte pendente para o profissional");
pendentes.sort(function (a, b) { return a.created_at < b.created_at ? 1 : -1; });
pedir("PATCH", "/attendances/cut-requests/" + pendentes[0].id + "/" + ACAO, null, token);
output.PEDIDO_ID = pendentes[0].id;
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${EMAIL_PROF}, ACAO=accept}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/responder_pedido.js, condition=null, label=10.07 · o profissional aceita (API), optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${typeof SUPERVISAO === 'undefined' || SUPERVISAO != '2'}, label=null), sourceDescription=null, config=null, label=null, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=Pedido aceito, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=300000, label=10.0A · espera o Andre aceitar o pedido no Partner (até 5 min), optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${typeof SUPERVISAO !== 'undefined' && SUPERVISAO == '2'}, label=null), sourceDescription=null, config=null, label=null, optional=false)), MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=Pedido aceito, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=60000, label=10.08 · espera Pedido aceito, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(applyConfigurationCommand=ApplyConfigurationCommand(config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowS