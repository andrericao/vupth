  var r = null;
  for (var vez = 0; vez < 4; vez++) {
    r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
    if (r.status !== 429 || vez === 3) break;
    var n = /in (\d+) s/.exec(r.body || "");
    var ate = Date.now() + ((n ? parseInt(n[1], 10) : 30) + 2) * 1000;
    while (Date.now() < ate) {}
  }
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var emailFila = "fila_c" + TAG + "@teste.com";
pedir("POST", "/auth/register", { email: emailFila, password: SENHA });
var tokenFila = pedir("POST", "/auth/login", { email: emailFila, password: SENHA }).tokens.access_token;
pedir("PATCH", "/profile/general-infos", { first_name: "Na fila" }, tokenFila);
pedir("POST", "/attendances", { professionalId: PROF_ID, establishmentId: LOJA_ID, serviceItemIds: [SERVICO_ID] }, tokenFila);

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
pedir("PATCH", "/professional/me/accepting-new", { value: false }, token);
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${output.EMAIL_PROF}, TAG=${output.TAG}, PROF_ID=${output.PROF_ID}, LOJA_ID=${output.LOJA_ID}, SERVICO_ID=${output.SERVICO_ID}}, sourceDescription=/home/andre/Documentos/programacao/vupth-project/vupth/.maestro/scripts/fechar_fila.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=false, label=null), sourceDescription=null, config=null, label=25.P4 · fecha a fila pela API (um cliente entra antes), optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
