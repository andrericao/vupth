08:25:10.896 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: 00.P0 · prepara a etapa metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(defineVariablesCommand=DefineVariablesCommand(env={ETAPA=00, LOJA=0, CONTA=1, ABERTURA=1, FILA_FECHADA=0}, label=null, optional=false)), MaestroCommand(applyConfigurationCommand=ApplyConfigurationCommand(config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=null, optional=false)), MaestroCommand(evalScriptCommand=EvalScriptCommand(scriptString=${output.TAG = (typeof TAG !== 'undefined' && TAG ? String(TAG) : String(Date.now()).slice(-6)) + ETAPA}, label=${ETAPA}.P1 · calcula TAG, optional=false)), MaestroCommand(evalScriptCommand=EvalScriptCommand(scriptString=${output.EMAIL_CLIENTE = 'client_c' + output.TAG + '@teste.com'; output.NOME_CLIENTE = 'Cliente' + output.TAG}, label=${ETAPA}.P2 · calcula o cliente, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Monta, pela API do staging, uma loja ABERTA com um profissional TRABALHANDO
// e um servico — o papel do app do Partner, para a bateria do client nao
// depender dele. Solo shop: o dono e o proprio profissional.
//
// Entradas (env do runScript): API, SENHA, TAG
// Saidas: output.LOJA, output.LOJA_ID, output.PROF, output.PROF_ID,
//         output.SERVICO_ID, output.EMAIL_PROF

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
