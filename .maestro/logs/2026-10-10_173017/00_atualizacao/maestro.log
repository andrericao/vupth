// e um servico — o papel do app do Partner, para a bateria do client nao
// depender dele. Solo shop: o dono e o proprio profissional.
//
// Entradas (env do runScript): API, SENHA, TAG
// Saidas: output.LOJA, output.LOJA_ID, output.PROF, output.PROF_ID,
//         output.SERVICO_ID, output.EMAIL_PROF

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

// Cada papel novo (OWNER, PROFESSIONAL) so vale no token depois do refresh.
function renovar(refresh) {
  return pedir("POST", "/auth/refresh", { refresh_token: refresh });
}

var loja = "Loja C" + TAG;
var prof = "Prof" + TAG;
var email = "prop_c" + TAG + "@teste.com";

pedir("POST", "/auth/register", { email: email, password: SENHA });
var sessao = pedir("POST", "/auth/login", { email: email, password: SENHA }).tokens;

var est = pedir("POST", "/establishment/quick-create", { name: loja, serviceType: "BARBER" }, sessao.access_token);
sessao = renovar(sessao.refresh_token);

// Sem horario a loja nao abre (422 ESTABLISHMENT_HOURS_REQUIRED). O dia todo,
// para a bateria rodar a qualquer hora (perto da meia-noite, o bateria.sh espera).
pedir("PATCH", "/establishment/" + est.id + "/general-infos", { opening_time: "00:00", closing_time: "23:59" }, sessao.access_token);

var p = pedir("POST", "/professional/quick-create", { name: prof, establishmentId: est.id, specialty: "Corte" }, sessao.access_token);
sessao = renovar(sessao.refresh_token);

var servico = pedir("POST", "/establishment/" + est.id + "/service-items", {
  establishmentId: est.id,
  serviceItemType: "CORTE_MAQUINA",
  customName: "Corte " + TAG,
  price: 40.0,
  estimatedMinutes: 30
}, sessao.access_token);

// Trabalhando: a loja abre sozinha (open_status derivado, S1 fatia 2).
pedir("PATCH", "/professional/me/status", { status: "WORKING" }, sessao.access_token);

output.LOJA = loja;
output.LOJA_ID = est.id;
output.PROF = prof;
output.PROF_ID = p.id;
output.SERVICO_ID = servico.id;
output.EMAIL_PROF = email;
, env={API=${API}, SENHA=${SENHA}, TAG=${output.TAG}}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/loja_aberta.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${LOJA == '1'}, label=null), sourceDescription=null, config=null, label=${ETAPA}.P3 · monta a loja pela API, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Fecha a fila do profissional de teste pela API (o "fechar fila" do Partner):
// ele continua trabalhando, mas nao aceita cliente novo.
//
// Fila VAZIA fechada vira OFF (regra do Andre de 22/07, Backend 4f817a0): o
// profissional sai do expediente e a loja fecha. Com alguem na fila ele segue
// WORKING ("Fila fechada") ate o ultimo atendimento. Por isso, antes de fechar,
// um segundo cliente (fila_c<TAG>, so pela API) entra na fila dele.
//
// Entradas (env do runScript): API, SENHA, EMAIL_PROF, TAG, PROF_ID, LOJA_ID, SERVICO_ID

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

var emailFila = "fila_c" + TAG + "@teste.com";
pedir("POST", "/auth/register", { email: emailFila, password: SENHA });
var tokenFila = pedir("POST", "/auth/login", { email: emailFila, password: SENHA }).tokens.access_token;
pedir("PATCH", "/profile/general-infos", { first_name: "Na fila" }, tokenFila);
pedir("POST", "/attendances", { professionalId: PROF_ID, establishmentId: LOJA_ID, serviceItemIds: [SERVICO_ID] }, tokenFila);

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
pedir("PATCH", "/professional/me/accepting-new", { value: false }, token);
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${output.EMAIL_PROF}, TAG=${output.TAG}, PROF_ID=${output.PROF_ID}, LOJA_ID=${output.LOJA_ID}, SERVICO_ID=${output.SERVICO_ID}}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/fechar_fila.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${FILA_FECHADA == '1'}, label=null), sourceDescription=null, config=null, label=${ETAPA}.P4 · fecha a fila pela API (um cliente entra antes), optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Poe o profissional de teste em "Fora" pela API (as pills de status do
