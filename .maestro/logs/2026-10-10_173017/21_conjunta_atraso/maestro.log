  return r.body ? json(r.body) : null;
}

var token = pedir("POST", "/auth/login", { email: EMAIL_PROF, password: SENHA }).tokens.access_token;
pedir("PATCH", "/professional/me/status", { status: "OFF" }, token);
, env={API=${API}, SENHA=${SENHA}, EMAIL_PROF=${output.EMAIL_PROF}}, sourceDescription=/home/andre/Documentos/programacao/vupth/.maestro/scripts/profissional_fora.js, condition=null, label=null, optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptCondition=${typeof PROF_FORA !== 'undefined' && PROF_FORA == '1'}, label=null), sourceDescription=null, config=null, label=${ETAPA}.P4b · põe o profissional em Fora pela API, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(runScriptCommand=RunScriptCommand(script=// Cria, pela API do staging, a conta do cliente de uma etapa avulsa
// (bateria-nao-para): cada etapa roda sozinha e nao herda o cadastro da 02.
// Ja com o nome, para o login nao parar na tela "Como podemos te chamar?".
