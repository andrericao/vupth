var esperado = (typeof COMMIT === "undefined" || COMMIT == null ? "" : String(COMMIT)).trim().toLowerCase().slice(0, 8);
var instalado = String(maestro.copiedText || "");

// Sem COMMIT (rodada fora da bateria.sh, 03/10): nao trava a bateria — avisa
