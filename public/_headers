# Cabecalhos de seguranca do build WEB (mitigacao 2 do D8, 2026-08-12 —
# espelho do arquivo do partner; o C26 exige que a dupla nao divirja).
#
# Formato lido por Cloudflare Pages e Netlify sem configuracao extra: o Expo
# copia o conteudo de `public/` para a saida do `expo export --platform web`.
#
# Por que isto importa AQUI: na web o token nao mora em cofre do sistema, e sim
# no `localStorage` (ver web-shims/expo-secure-store.js) — legivel por qualquer
# JavaScript da mesma origem. O vetor real e XSS, e o CSP e a defesa mais
# eficaz contra ele.
#
# ⚠️ Desde 2026-09-19 o CSP carrega SOZINHO o lado da seguranca: a outra metade
# da dupla era o `sessionStorage`, que encurtava a janela morrendo com a aba, e
# o Andre trocou por `localStorage` para a sessao sobreviver ao fechamento.
# Mexer neste arquivo ficou mais caro do que era.

/*
  # Sem CSP, um <script> injetado le o token e o manda p/ fora. Com ele, o
  # navegador simplesmente nao executa o que nao veio da nossa origem.
  # 'unsafe-inline' em style-src: o React Native Web injeta estilos inline —
  # sem isso a pagina sobe sem CSS nenhum.
  # connect-src precisa listar o backend E o WebSocket (wss:), senao a fila
  # para de atualizar sem erro visivel.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://vupth-backend-ia.onrender.com https://vupth-backend-ia-production.up.railway.app wss://vupth-backend-ia.onrender.com wss://vupth-backend-ia-production.up.railway.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  # Impede que o app seja embutido em iframe de terceiro (clickjacking).
  X-Frame-Options: DENY
  # Nao deixa o navegador "adivinhar" o tipo de um arquivo servido.
  X-Content-Type-Options: nosniff
  # Nao vaza a URL interna (com ids) ao clicar p/ fora.
  Referrer-Policy: strict-origin-when-cross-origin
  # Camera e microfone negados. O GPS fica liberado SO para a nossa origem: a
  # busca por proximidade usa a localizacao, e com geolocation=() o navegador
  # negava sem nem perguntar (melhoria de 02/10).
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  # Forca HTTPS nas proximas visitas.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Cache (melhoria de 02/10). Os bundles do `expo export` levam o hash no nome:
# um arquivo novo e outra URL, entao o navegador pode guardar um ano sem nunca
# servir versao velha. O index.html e o que aponta para eles — esse o navegador
# confere a cada visita, senao o deploy novo nao chega.
# ⚠️ Cache-Control so nestes blocos, nunca no /*: o Pages JUNTA os valores de
# blocos que casam na mesma URL, e "immutable" somado a "no-cache" nao vale nada.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
